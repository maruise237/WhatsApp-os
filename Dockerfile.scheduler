# Scheduler des crons — crond de busybox qui frappe les routes /api/v1/cron/* par le réseau
# interne du compose. Sans docker.sock : le conteneur ne parle pas au daemon, seulement en HTTP.
#
# Existe en tant qu'image (au lieu de `alpine:3.20` + `apk add` dans la command du compose)
# parce qu'installer un paquet à chaque démarrage lie la reprise du cron du client à
# l'internet du VPS et au miroir Alpine — une dépendance réseau sur un chemin qui
# devrait être hors ligne. Doctrine : docs/doctrine/packaging.md, invariant 1.
FROM alpine:3.20

LABEL org.opencontainers.image.source="https://github.com/melgarafael/DeskcommCRM" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="DeskcommCRM scheduler"

ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION \
    TZ=UTC

RUN apk add --no-cache curl tzdata

COPY docker/scheduler/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Preuve de vie : si crond meurt, le conteneur tombe et le `restart: unless-stopped`
# le ramène. Sans cela, un crond mort est indiscernable d'un cron inactif.
HEALTHCHECK --interval=60s --timeout=5s --start-period=10s --retries=3 \
  CMD pgrep crond >/dev/null || exit 1

CMD ["/usr/local/bin/entrypoint.sh"]
