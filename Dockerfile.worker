# Worker 24/7 de l'agent-engine — processus de longue durée hors de Next.
#
# Deux étapes : la première installe les dépendances et compile le worker en UN
# fichier JS (scripts/build-worker.mjs) ; la seconde n'emporte que ce fichier.
# Avant, l'image exécutait du TypeScript via `tsx` avec toutes les devDependencies :
# 286 Mo de RSS au démarrage contre 169 Mo pour le bundle, et une image d'~1 Go.
FROM node:22-alpine AS build
WORKDIR /app
# pnpm fixé sur la version du lockfile du dépôt (pnpm 10 bloquerait les scripts de build).
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN node scripts/build-worker.mjs

FROM node:22-alpine
WORKDIR /app

# Provenance (doctrine de packaging, invariant 2).
LABEL org.opencontainers.image.source="https://github.com/maruise237/WhatsApp-os" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="WhatsApp OS worker"

ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION \
    NODE_ENV=production

# Seul paquet resté hors du bundle (voir scripts/build-worker.mjs). Même
# version que le lockfile ; les optionnelles restent (le binaire
# @napi-rs/canvas fournit le DOMMatrix dont pdfjs 6 a besoin).
ARG PDFJS_VERSION=6.2.108
RUN npm install --omit=dev --no-save --no-audit --no-fund "pdfjs-dist@${PDFJS_VERSION}" \
 && npm cache clean --force

COPY --from=build /app/dist/worker/worker.mjs ./worker.mjs
# Lu à l'exécution par lib/agent-engine/agent/playbook-seed.ts (process.cwd()).
COPY --from=build /app/lib/agent-engine/playbooks ./lib/agent-engine/playbooks

USER node
# Healthz du worker (écoute sur 0.0.0.0 dans le conteneur).
EXPOSE 8787

CMD ["node", "worker.mjs"]
