# Worker 24/7 do agent-engine — processo long-running fora do Next.
#
# Duas etapas : a primeira instala as dependências e compila o worker em UM
# arquivo JS (scripts/build-worker.mjs) ; a segunda só leva esse arquivo.
# Antes, a imagem rodava TypeScript via `tsx` com todas as devDependencies :
# 286 MB de RSS no boot contra 169 MB do bundle, e uma imagem de ~1 GB.
FROM node:22-alpine AS build
WORKDIR /app
# pnpm fixado na versão do lockfile do repo (pnpm 10 bloquearia build scripts).
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN node scripts/build-worker.mjs

FROM node:22-alpine
WORKDIR /app

# Procedência (doutrina de packaging, invariante 2).
LABEL org.opencontainers.image.source="https://github.com/maruise237/WhatsApp-os" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="WhatsApp OS worker"

ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION \
    NODE_ENV=production

# Seul paquet resté hors du bundle (voir scripts/build-worker.mjs). Même
# version que le lockfile ; les optionnelles restent (le binaire
# @napi-rs/canvas fournit le DOMMatrix dont pdfjs 6 a besoin).
ARG PDFJS_VERSION=6.2.108
RUN npm install --omit=dev --no-save --no-audit --no-fund "pdfjs-dist@${PDFJS_VERSION}" \
 && npm cache clean --force

COPY --from=build /app/dist/worker/worker.mjs ./worker.mjs
# Lu à l'exécution par lib/agent-engine/agent/playbook-seed.ts (process.cwd()).
COPY --from=build /app/lib/agent-engine/playbooks ./lib/agent-engine/playbooks

USER node
# Healthz do worker (bind 0.0.0.0 dentro do container).
EXPOSE 8787

CMD ["node", "worker.mjs"]
