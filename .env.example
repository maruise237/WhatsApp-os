# =============================================================================
# DeskcommCRM — variables d'environnement
# =============================================================================
# Copiez vers .env.local et remplissez. Ne JAMAIS committer les .env*.
# Les variables NEXT_PUBLIC_* sont exposées au navigateur ; le reste reste côté serveur.
# =============================================================================

# --- Neon ---------------------------------------------------------------------
# URL publique du Managed Better Auth de Neon.
NEON_AUTH_BASE_URL=
# URL publique de la Neon Data API/PostgREST.
NEON_DATA_API_URL=
# Connection string du Postgres Neon pour le worker et les transactions métier.
# Serveur uniquement : elle ne doit jamais être exposée au navigateur ni commitée.
NEON_DATABASE_URL=
# Secret du cookie de session Better Auth (32 caractères minimum). Serveur uniquement.
NEON_AUTH_COOKIE_SECRET=

# --- Cron / interne ----------------------------------------------------------
# Secret Bearer pour les endpoints /api/v1/cron/*. À conserver distinct de la connexion DB.
INTERNAL_SECRET=
# Secret dédié optionnel pour les endpoints de cron. Si vide, retombe sur INTERNAL_SECRET.
INTERNAL_CRON_SECRET=

# --- Fenêtre des rappels planifiés -------------------------------------------
# À quel point tôt et tard l'agent peut planifier un rappel au client. Lues par le
# WORKER (agent-engine) et par l'APP (la capacité que le propriétaire active à l'écran) — les
# deux lectures doivent concorder, sinon le même horaire serait accepté sur un chemin et
# refusé sur l'autre. Valeurs par défaut dans lib/followup/janela.ts ; laissez vide pour les utiliser.
# FOLLOWUP_MIN_AHEAD_MS=300000        # 5 min
# FOLLOWUP_MAX_AHEAD_MS=15552000000   # 180 jours
# CRON_STAGGER_WINDOW_MS=60000        # étale les déclenchements de la même minute (0 désactive)

# --- Clés de chiffrement (pgcrypto) ------------------------------------------
# Clé séparée pour chiffrer le numéro d'identité dans contacts (donnée personnelle sensible).
CPF_ENCRYPTION_KEY=
# Clé pour chiffrer les jetons OAuth Nuvemshop dans tenant_integrations.
NUVEMSHOP_OAUTH_ENCRYPTION_KEY=
# Clé pour chiffrer les identifiants BYO-WAHA (client qui fait tourner son propre WAHA).
WAHA_BYO_ENCRYPTION_KEY=
# Clé AES-256 (32 octets en base64) pour chiffrer les clés d'API des fournisseurs LLM
# (ai_provider_credentials). Générer : openssl rand -base64 32
AI_CRED_AES_KEY=

# --- Profils Compose (docker-compose.dokploy.yml) ------------------------------
# Par défaut, seul le cœur démarre (app, worker, scheduler, Evolution Go + sa
# base, gateway, SeaweedFS). Services optionnels, à activer seulement si besoin :
#   waha   — moteur WhatsApp historique (renseignez alors WAHA_API_BASE_URL=http://waha-internal:3000)
#   redis  — Redis + srh (renseignez alors UPSTASH_REDIS_REST_URL=http://srh:80 et le token)
# Ex. : COMPOSE_PROFILES=redis
COMPOSE_PROFILES=

# --- WhatsApp gateway ---------------------------------------------------------
# L’app et le worker parlent uniquement à ce proxy interne ; ils ne reçoivent
# jamais l’URL ou la clé d’Evolution Go directement.
WHATSAPP_GATEWAY_BASE_URL=http://localhost:8788
WHATSAPP_GATEWAY_TOKEN=
# Activation du provider Evolution Go via le gateway (profil Compose sales-os).
EVOLUTION_GO_IMAGE=evoapicloud/evolution-go:latest
EVOLUTION_GO_BASE_URL=http://evolution-go:8080
EVOLUTION_GO_API_KEY=
EVOLUTION_GO_WEBHOOK_SECRET=
EVOLUTION_GO_POSTGRES_AUTH_DB=
EVOLUTION_GO_POSTGRES_USERS_DB=
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:3.80
SEAWEEDFS_S3_ENDPOINT=http://localhost:8333
SEAWEEDFS_S3_REGION=us-east-1
SEAWEEDFS_S3_ACCESS_KEY=local-sales-os
SEAWEEDFS_S3_SECRET_KEY=change-me
SEAWEEDFS_MEDIA_BUCKET=media-bucket

# --- WAHA historique (optionnel : laisser vide si vous n'utilisez qu'Evolution Go)
# URL de base de l'instance WAHA (ex. : http://localhost:3000 en dev ; https://waha.votredomaine.com en prod)
WAHA_API_BASE_URL=http://localhost:3000
# Texte clair de la clé d'API WAHA. L'ENV du conteneur WAHA reçoit le hash SHA512 hex de celle-ci.
# Générer : echo -n "ma-cle-ici" | shasum -a 512
WAHA_API_KEY=
# Secret avec lequel WAHA signe les webhooks (en-tête X-Webhook-Hmac). L'app l'utilise
# pour VÉRIFIER la signature ; le conteneur WAHA reçoit la même valeur.
WAHA_HMAC_SECRET=
# "true" exige une signature valide sur TOUT webhook WAHA. Désactivé par défaut
# parce que WAHA Core ne signe pas — l'exiger arrêterait l'ingestion des messages.
# Activez-le si vous faites tourner WAHA Plus (ou un proxy qui signe).
WAHA_WEBHOOK_REQUIRE_SIGNATURE=false
# URL publique de l'app que WAHA appelle pour les webhooks (doit être en HTTPS public ; utilisez ngrok en dev).
WAHA_WEBHOOK_BASE_URL=
# Reprendre les sessions déjà appairées quand le conteneur WAHA redémarre. C'est lu
# par WAHA, pas par l'app (c'est pourquoi ce n'est pas dans lib/env.ts). La valeur par défaut de WAHA est
# False : le volume garde l'identifiant, mais la session ne démarre pas, et le numéro reste
# « connecté » sur le disque et muet en pratique jusqu'à ce que quelqu'un ouvre le front et clique
# Reconnecter. Ne touchez à ceci que si vous voulez l'ancien comportement exprès.
WHATSAPP_RESTART_ALL_SESSIONS=True

# --- OpenRouter : attribution OPTIONNELLE ------------------------------------
# `HTTP-Referer` et `X-Title` qu'OpenRouter utilise pour attribuer la consommation et
# construire le classement public de son site. Ils sont OPTIONNELS — leur doc dit
# « optional headers to identify your app », et l'appel fonctionne sans. Vides,
# aucun en-tête n'est envoyé. Remplissez-les avec VOTRE domaine et VOTRE nom si vous voulez
# que la consommation de cette installation vous soit attribuée.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=

# --- Upstash Redis (optionnel) ------------------------------------------------
# Vide = repli en mémoire (suffisant sur une seule VPS). Ne renseignez ces deux
# variables que si Redis tourne vraiment (profil `redis`) : une URL vers un
# service absent fait échouer le debounce du RAG au lieu de le désactiver.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- IA ----------------------------------------------------------------------
# IA FOURNIE PAR LA PLATEFORME (recommandé, mode SaaS) — une seule clé DeepSeek
# pour toutes les organisations, à poser dans l'onglet Environment de Dokploy.
# Présente, elle GAGNE sur toute clé ou tout modèle choisi par une organisation,
# et l'interface ne montre plus aucun réglage de fournisseur ni de modèle.
# Le modèle par défaut (`deepseek-flash`) lit les images : captures de paiement,
# photos de produits. Voir lib/ai/plateforme.ts.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=                       # vide = https://api.deepseek.com
DEEPSEEK_MODEL=                          # vide = deepseek-flash
# Intensité de réflexion facturée comme de la sortie : off | low | high | max.
DEEPSEEK_REFLEXION=                      # vide = low

# Embeddings de la base de connaissances (text-embedding-3-small) et
# transcription des notes vocales. DeepSeek ne fournit ni l'un ni l'autre :
# sans cette clé, l'assistant répond sans base de connaissances et demande au
# client d'écrire au lieu d'envoyer un vocal.
OPENAI_API_KEY=

# Anciens chemins, ignorés quand DEEPSEEK_API_KEY est présente. Ordre de
# résolution sans elle : AI_GATEWAY_API_KEY > OPENROUTER_API_KEY > fournisseur
# direct (ANTHROPIC_API_KEY / OPENAI_API_KEY).
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
VERCEL_AI_GATEWAY_URL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=                     # vide = https://openrouter.ai/api/v1
# Sur ces anciens chemins, un modèle sans support des outils (tools) ne lève
# aucune erreur : il répond au client et ne crée jamais le lead.

# --- Plafond de dépenses d'IA : le levier d'urgence ---------------------------
# C'est chaque organisation qui choisit son plafond, dans l'écran Utilisation de l'IA › Budget (plafond,
# alerte, et si l'IA doit S'ARRÊTER en l'atteignant). Cette clé ne choisit rien : elle
# sait seulement ASSOUPLIR ce qui a déjà été choisi.
#   on      (défaut) respecte ce que chaque organisation a choisi
#   avisar  ramène tout « arrêter l'IA » à un simple avertissement
#   off     désactive la protection sur toute cette installation
# Valent aussi comme off : false, 0, no, disabled. Une valeur non
# reconnue retombe sur `on` — exprès : le levier d'urgence ne doit JAMAIS
# faire tomber l'app pour une faute de frappe. Changé ? redémarrez l'app et le worker.
AI_BUDGET_ENFORCEMENT=on

# --- Workers -----------------------------------------------------------------
# Rythme auquel le WORKER exécute les handlers de l'event_log (médias, branding,
# relances…). Avant ces réglages les handlers ne tournaient que par le cron
# `event-log-drain`, 1×/min — et la chaîne persist→derive d'un audio prenait
# 103-188 s contre les 45 s que le tour attend pour la transcription. Le cron reste
# actif comme filet de sécurité. Vide = les valeurs par défaut ci-dessous.
EVENT_LOG_DRAIN_INTERVAL_MS=2000
EVENT_LOG_DRAIN_IDLE_INTERVAL_MS=10000
EVENT_LOG_DRAIN_BATCH_SIZE=50
# Stub de l'endpoint de test de l'agent : 'true' renvoie une trace fabriquée au lieu
# d'exécuter l'agent. Laissez false — le vrai runtime existe déjà. Ne l'activez que pour
# exercer le rendu de l'interface sans dépenser de jetons.
INTERNAL_AGENT_RUN_STUB=false

# --- Sentry ------------------------------------------------------------------
SENTRY_DSN=

# --- E-mail transactionnel (Resend) -------------------------------------------
# Invitation d'équipe, livraison de l'export RGPD et alarme de SLA passent par ici.
#
# RESEND_FROM_EMAIL doit être une adresse d'un domaine VÉRIFIÉ dans VOTRE
# compte Resend. Vide = e-mail désactivé (l'invitation affiche le lien d'acceptation à
# l'écran et l'export RGPD reste en `pending_review`), et c'est voulu :
# hériter d'un domaine qui n'est pas le vôtre fait échouer tout envoi chez Resend, avec un
# message qui ne dit pas que le problème vient de la configuration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Impersonation / support --------------------------------------------------
# Secret HMAC du cookie d'impersonation. 32 caractères minimum quand la fonction est utilisée.
IMPERSONATE_COOKIE_SECRET=
# Adresse de support montrée au CLIENT FINAL (compte suspendu, facturation).
# Qui installe pour des tiers met ici sa propre adresse. Vide = l'écran n'affiche
# aucune adresse, et ne retombe jamais sur une adresse du produit.
SUPPORT_EMAIL=

# --- Protection des données (RGPD) --------------------------------------------
# Clé utilisée pour signer les exports de données personnelles.
LGPD_SIGNING_KEY=
# E-mail du délégué à la protection des données (DPO). Imprimé en pied du rapport remis à la
# personne concernée (`lib/lgpd/pdf-renderer.tsx`) quand l'organisation n'a pas son propre
# `dpo_email`, et c'est le destinataire de l'alarme de SLA.
LGPD_DPO_EMAIL=
# Délai, en heures, avant qu'un export de données expire.
LGPD_EXPORT_EXPIRES_HOURS=72

# --- Nuvemshop OAuth ---------------------------------------------------------
# À obtenir sur https://partners.tiendanube.com/ (créer une app → copier les identifiants).
# Laissez vide en dev/staging si vous n'avez pas encore d'app approuvée — l'intégration
# se dégrade proprement et l'interface affiche « Intégration non configurée ».
# Active l'intégration Nuvemshop. Quand true, exige les identifiants ci-dessous.
NUVEMSHOP_ENABLED=false
# APP_ID apparaît dans l'URL du panneau de l'app sur le portail partenaires.
NUVEMSHOP_APP_ID=
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
# Pour tester les webhooks en dev, exposez l'app via ngrok/cloudflared (HTTPS) et
# pointez NEXT_PUBLIC_APP_URL vers le tunnel avant de cliquer sur « Connecter ».

# --- URL de l'app ------------------------------------------------------------
# URL canonique de l'app (tenant). Ex. : https://app.votredomaine.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL canonique du super-admin. Ex. : https://admin.votredomaine.com
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000

# =============================================================================
# AGENT ENGINE (fusion Vendaval) — worker 24/7 de l'agent commercial
# =============================================================================
# Connection string du Postgres Neon. Le worker utilise Postgres directement (file FOR UPDATE
# SKIP LOCKED, verrous, FTS). Recommandé : un rôle dédié avec login — jamais le JWT
# de service ici.
NEON_DATABASE_URL=

# La connexion qui TOUCHE AU SCHÉMA — et SEUL le kit (install.sh/update.sh/backup.sh) l'
# utilise ; aucun code de l'app ne lit cette clé. OPTIONNELLE : vide, tout passe par celle
# du dessus, ce qui est le cas du cloud (la chaîne du pooler arrive déjà privilégiée).
# Remplissez-la quand la base est AUTO-HÉBERGÉE et que celle du dessus est le rôle restreint :
# `create extension`, le `baseline.sql` et la promotion du propriétaire exigent le propriétaire de la
# base. Voir docs/deploy-selfhost/README.md §2.
NEON_DATABASE_ADMIN_URL=

# --- Rythme de la file du worker (coût de base) ------------------------------
# Les deux gouvernent combien le worker parle à Postgres quand il N'y a PAS de travail
# — le compte qui a fait exploser le quota d'egress de l'offre gratuite dans l'issue #258.
# Les deux sont optionnels : sans eux valent les valeurs par défaut ci-dessous, qui sont le comportement
# recommandé. Pour voir ce qui est en vigueur : la ligne `agent-engine pronto` dans le journal
# du worker affiche les deux. Quand y toucher et quoi mesurer :
# docs/runbooks/custo-e-cota-do-supabase.md
#
# PLAFOND d'attente de la boucle de la file. Avec la file vide, c'est le temps que le worker dort entre
# une requête et la suivante ; avec un job planifié, il se réveille à l'échéance et cette
# valeur ne fait que limiter la sieste. Ne dépassez pas 10000 : au-delà la connexion inactive
# expire entre les tours et chaque requête repaie TCP+TLS — cela dépense PLUS.
#QUEUE_POLL_INTERVAL_MS=2000
# Rythme du « il y avait du travail et je ne l'ai pas pris » (toutes les places de
# QUEUE_MAX_CONCURRENCY occupées, ou un autre tour en cours pour le même contact).
# Ici un job échu attend une place, donc cette valeur est courte exprès :
# l'augmenter n'économise rien au repos et coûte du débit en pointe.
#QUEUE_CLAIM_RETRY_INTERVAL_MS=250

# ── Rétention de l'historique (purge quotidienne, cron `data-retention`) ─────
# L'espace disque est un quota différent de celui du trafic : l'offre gratuite
# limite à 500 Mo de BASE, et `job_queue` + `api_audit_log` sont les deux qui grossissent
# toutes seules. Les deux valeurs ci-dessous SONT DÉJÀ les valeurs par défaut du code : effacer les lignes
# d'un `.env` existant ne change rien, et qui met à jour sans toucher au fichier
# reçoit exactement ce comportement. Combien chaque table occupe aujourd'hui et quoi
# faire du chiffre : docs/runbooks/custo-e-cota-do-supabase.md
#
# Âge à partir duquel un job TERMINAL (done/failed/dead) est effacé. Un job
# `pending`/`running` n'est JAMAIS touché — il a du travail dedans. Effacer un job emporte
# avec lui le `send_ledger` et les `before_send_traces` de ce run. Plancher de 7 jours,
# appliqué dans la fonction de la base (une valeur plus petite est relevée, avec avertissement dans le journal).
JOB_QUEUE_RETENTION_DAYS=90
# Âge à partir duquel une ligne d'audit est purgée. La valeur par défaut est la
# rétention de 5 ans de la règle L-10. Plancher de 90 jours : même avec la clé de service
# cette purge n'atteint pas une trace récente. Diminuer ici est le levier de qui est
# à court d'espace et accepte de garder moins d'historique.
AUDIT_LOG_RETENTION_DAYS=1825

# Clé LLM de la plateforme (repli quand l'organisation n'a pas d'identifiant BYOK
# enregistré dans /app/ai/credentials). Optionnelle avec BYOK.
ANTHROPIC_API_KEY=

# Propriétaire UNIQUE des événements de dispatch de l'agent. 'engine' (défaut) = le worker
# consomme ; 'native' = le dispatcher interne de l'app consomme (déploiement sans worker).
# JAMAIS les deux — deux consommateurs = tour dupliqué ou perdu.
AGENT_DISPATCH_CONSUMER=engine

# Watchdog de session : réconcilie channel_sessions × WAHA et renvoie les messages
# bloqués en queued. Utilise WAHA_API_BASE_URL/WAHA_API_KEY ci-dessus (dans le compose le
# worker reçoit déjà http://waha:3000). Réglages optionnels :
#WATCHDOG_INTERVAL_MS=60000
#WATCHDOG_REDRIVE_BATCH_SIZE=10

# Flywheel planifié (juge → proposition d'amélioration ; promotion TOUJOURS manuelle dans
# l'écran des Agents IA). 0 = désactivé ; défaut 6 h.
#FLYWHEEL_INTERVAL_MS=21600000
#FLYWHEEL_BATCH_LIMIT=10

# ── Marque de l'installation (marque blanche) ───────────────────────────────
# Qui installe le CRM pour des clients (agence, revendeur) change la marque ici, sans
# éditer le code — un patch dans le code se perd à la prochaine mise à jour. Vide = défaut.
# APP_LOGO_URL accepte n'importe quelle URL publique d'image ; sans elle, le nom apparaît
# en texte. Voir lib/branding.ts.
APP_NAME=
APP_LOGO_URL=
# Couleur de la marque, en hex (ex. : #506d48). D'elle sort la rampe de 11 tons qui colore le
# produit entier — bouton, anneau de focus, puce, survol — dans les deux thèmes. Vide = la
# couleur du produit. Une couleur sans contraste suffisant est DÉCALÉE au lieu d'être refusée, et
# une marque achromatique (gris/noir/blanc) ne devient pas un accent : dans les deux cas le
# motif est consigné. Voir lib/branding/contraste.ts.
APP_ACCENT_HEX=

# --- WhatsApp Cloud API (Meta) — Phase 3a/3b de la couture des canaux ---
# Optionnelles : sans elles le canal officiel n'est simplement pas configuré, et WAHA
# continue de fonctionner. Rien ici n'ajoute de conteneur au compose — le serveur est le
# cloud de Meta.
META_APP_ID=
# App Secret : clé du HMAC SHA-256 qui valide les webhooks (X-Hub-Signature-256).
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_SYSTEM_USER_TOKEN=
# Jeton que VOUS choisissez ; Meta le renvoie lors du handshake (hub.verify_token) pour
# prouver que l'endpoint est le vôtre. Sans lui le GET de vérification répond 403.
META_WEBHOOK_VERIFY_TOKEN=
# Version de la Graph API. Explicite exprès : la monter est une décision, pas une dérive.
META_GRAPH_VERSION=v22.0

# --- Canal via intermédiaire (BSP) — optionnel ---
# Laissez vide si vous n'utilisez pas ce canal ; rien ne casse sans ces trois-là.
#
# Les DEUX du bas vont ensemble : l'adaptateur ne se considère configuré qu'avec les
# deux remplies. N'en remplir qu'une n'est pas une demi-mesure — c'est l'état qui faisait
# marquer le message comme envoyé sans qu'il parte, et c'est pourquoi la vérification exige maintenant
# la paire. L'identifiant peut aussi vivre dans la SESSION (chiffré), et alors celles-ci restent
# vides.
ZERNIO_ACCOUNT_ID=
ZERNIO_API_KEY=
# Seulement pour pointer vers la préproduction. Vide utilise la production du fournisseur.
ZERNIO_API_BASE_URL=

# --- Plafond de connexion par IP (SEULEMENT pour la CI e2e) ---
# NE définissez PAS ceci en production ni sur un VPS. La valeur par défaut (60 tentatives par IP
# toutes les 5 min) est la bonne valeur pour un usage réel et elle est déjà large à cause du NAT.
#
# Existe parce qu'en CI tous les tests sortent d'UNE IP (le runner) : 28 specs e2e
# dépassent le plafond et la connexion se met à répondre « Trop de tentatives », recalant
# des specs qui n'ont rien à voir avec l'authentification.
#
# Le plafond par COMPTE (5 échecs sur le même compte en 5 min) N'est PAS configurable
# exprès — c'est lui qui bloque la force brute, y compris distribuée sur plusieurs IP.
# Une valeur invalide ou absente retombe sur la valeur par défaut : l'échec est fermé.
# AUTH_RATE_LIMIT_LOGIN_IP=1000

# Rétention de l'archive du corps brut des webhooks (webhook_events_log).
# 7 jours gardent la base dans les 500 Mo de l'offre gratuite ; l'
# archive faisait 86 % de la base sur une vraie installation, en grossissant de ~23 Mo/jour.
WEBHOOK_LOG_BODY_RETENTION_DAYS=7
# Quand la LIGNE disparaît (pas seulement le corps). Jusque-là elle coûte ~200 o et
# répond encore combien d'événements sont arrivés, de quel type et si la signature concordait.
WEBHOOK_LOG_ROW_RETENTION_DAYS=90

# Rétention de l'HISTORIQUE des leads captés (webhook_lead_captures) — l'onglet
# « Leads reçus ». Bien plus longue que celle de l'archive ci-dessus parce qu'ici la ligne
# EST le produit : c'est elle qui répond de quelle campagne venait le client qui a conclu.
# ~1 Ko par formulaire rempli, donc 300/jour pendant un an donnent ~110 Mo.
# Le code qui efface applique un plancher de 30 jours — un nombre plus petit ne désarme pas la
# preuve d'origine d'un contact.
LEAD_CAPTURE_RETENTION_DAYS=365
